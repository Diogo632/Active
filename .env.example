# Porta HTTP da plataforma
PORT=3000

# Pasta onde ficam o banco SQLite e os arquivos enviados
DATA_DIR=./data

# Tamanho máximo por arquivo enviado (MB)
MAX_UPLOAD_MB=100

# ---------- Active AI via n8n (GPTMaker) ----------
# URL de produção do webhook da Active AI no n8n
N8N_WEBHOOK_URL=https://n8n.activecorp.com.br/webhook/active-ia-msg
# Opcional: token enviado como "Authorization: Bearer <token>" (use Header Auth no webhook do n8n)
N8N_WEBHOOK_TOKEN=
# Tempo máximo de espera pela resposta (segundos)
N8N_TIMEOUT_SECONDS=120
# true: a mensagem enviada ao workflow já inclui os documentos relevantes da base (padrão)
# false: envia só a pergunta (quando o workflow consulta a base pela API de integração)
N8N_INCLUDE_CONTEXT=true
# Tamanho máximo (caracteres) da mensagem enviada à Active AI. O GPTMaker enxerga ~4.000 por mensagem;
# o conteúdo completo dos documentos o agente lê pelo MCP (/mcp).
N8N_MAX_PROMPT_CHARS=3500

# Token que libera o servidor MCP (/mcp) e a API de integração (/api/integracao/*).
# Use um valor longo e aleatório; sem ele, o MCP fica desligado.
INTEGRATION_TOKEN=
# Endereço público da plataforma (usado nos links que o MCP devolve ao agente)
PUBLIC_URL=

# ---------- Alternativa: API da Anthropic (usada só se N8N_WEBHOOK_URL estiver vazio) ----------
ANTHROPIC_API_KEY=
ACTIVE_IA_MODEL=claude-opus-5

# Opcional: protege a plataforma com usuário e senha (HTTP Basic)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
